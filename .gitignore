# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Virtual environments ---
venv/
.venv/
env/

# --- Secrets (DVC remote credentials live in .dvc/config.local) ---
.env
.env.*
*.pem
*.key

# --- Editor / IDE / OS ---
.vscode/
.idea/
.puku/
*.swp
.DS_Store
Thumbs.db
.ipynb_checkpoints/

# --- Data and models: tracked by DVC, never by Git ---
# (DVC adds the exact output paths to the .gitignore files next to them;
#  these broader rules are a safety net.)
/data/raw/*.csv
/data/interim/
/data/processed/*.parquet
/models/**/*.joblib
/models/**/*.pkl
/artifacts/
/reports/shap/

# --- Dashboard runtime state ---
data/cache/risk_history.db

# --- Logs / scratch ---
*.log
*.tmp

# --- DVC plot renders (dvc plots show) ---
dvc_plots/
