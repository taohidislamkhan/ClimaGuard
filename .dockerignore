.claude/
.dvc/cache/
.dvc/tmp/
.dvc/config.local
.env
.env.*
instance/
.puku/
.vscode/
.idea/
.pytest_cache/

data/raw/
data/processed/train.parquet
data/processed/val.parquet
data/processed/test.parquet
models/candidates/
data/cache/risk_history.db
docs/
*.log
*.tmp
